{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "CaseGraph's own window; Rust commands additionally check the active service origin.",
  "windows": ["main"],
  "remote": { "urls": ["http://127.0.0.1:*"] },
  "permissions": [
    "core:event:allow-listen", "core:event:allow-unlisten",
    "allow-get-state", "allow-save-settings", "allow-service", "allow-open-client",
    "allow-clear-apply-error", "allow-pick-directory", "allow-open-log-folder",
    "allow-open-settings", "allow-renderer-ready"
  ]
}
